{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"NODE_ENV",
		"CI",
		"DO_NOT_TRACK",
		"HTTP_PROXY",
		"HTTPS_PROXY",
		"PARADOC_NO_UPDATE_CHECK",
		"PARADOC_TELEMETRY_DEBUG",
		"PARADOC_TELEMETRY_DISABLED",
		"PARADOC_SKIP_CHROMIUM_TESTS",
		"PUPPETEER_EXECUTABLE_PATH",
		"TEST_REGISTRY_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
		},
		"@paradoc/schemas#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "schemas/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^build"]
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"clean": {
			"cache": false
		}
	}
}
