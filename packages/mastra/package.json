{
  "name": "@paradoc/mastra",
  "version": "0.5.0",
  "description": "Mastra adapter for Paradoc tools — wraps @paradoc/ai-tools with Mastra createTool()",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./get-registry": {
      "types": "./dist/get-registry.d.ts",
      "import": "./dist/get-registry.js",
      "default": "./dist/get-registry.js"
    },
    "./get-artifact": {
      "types": "./dist/get-artifact.d.ts",
      "import": "./dist/get-artifact.js",
      "default": "./dist/get-artifact.js"
    },
    "./inspect-artifact": {
      "types": "./dist/inspect-artifact.d.ts",
      "import": "./dist/inspect-artifact.js",
      "default": "./dist/inspect-artifact.js"
    },
    "./validate-artifact": {
      "types": "./dist/validate-artifact.d.ts",
      "import": "./dist/validate-artifact.js",
      "default": "./dist/validate-artifact.js"
    },
    "./validate-input": {
      "types": "./dist/validate-input.d.ts",
      "import": "./dist/validate-input.js",
      "default": "./dist/validate-input.js"
    },
    "./fill": {
      "types": "./dist/fill.d.ts",
      "import": "./dist/fill.js",
      "default": "./dist/fill.js"
    },
    "./get-fill-state": {
      "types": "./dist/get-fill-state.d.ts",
      "import": "./dist/get-fill-state.js",
      "default": "./dist/get-fill-state.js"
    },
    "./update-fill": {
      "types": "./dist/update-fill.d.ts",
      "import": "./dist/update-fill.js",
      "default": "./dist/update-fill.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js",
      "default": "./dist/extract.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "paradoc",
    "mastra",
    "ai",
    "tools",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "author": "Paradoc (https://paradoc.dev)",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paradoc-dev/paradoc.git",
    "directory": "packages/mastra"
  },
  "homepage": "https://paradoc.dev",
  "bugs": {
    "url": "https://github.com/paradoc-dev/paradoc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "pack:dry": "pnpm run build && npm pack --dry-run",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "check": "pnpm lint && pnpm check-types"
  },
  "dependencies": {
    "@paradoc/ai-tools": "workspace:*"
  },
  "peerDependencies": {
    "@mastra/core": "^1.64.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@mastra/core": "1.64.0",
    "@paradoc/core": "workspace:*",
    "@paradoc/eslint-config": "workspace:*",
    "@paradoc/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "directories": {
    "test": "tests"
  }
}
