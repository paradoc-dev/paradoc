{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.paradoc.dev/config.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema URI for validation"
    },
    "registries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^@[a-zA-Z0-9][a-zA-Z0-9-_]*$",
        "description": "Registry namespace (must start with @)"
      },
      "additionalProperties": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "description": "Configured registries by namespace"
    },
    "defaults": {
      "$ref": "#/$defs/GlobalDefaults"
    },
    "cache": {
      "type": "object",
      "properties": {
        "ttl": {
          "default": 3600,
          "description": "Default cache TTL in seconds. 0 disables caching. Default: 3600 (1 hour)",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "directory": {
          "type": "string",
          "description": "Custom cache directory path. Default: ~/.paradoc/cache"
        }
      },
      "additionalProperties": false,
      "title": "CacheConfig",
      "description": "Global cache configuration for registry data"
    },
    "security": {
      "type": "object",
      "properties": {
        "allowedContentTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Content types permitted for layer downloads, added to the built-in defaults. Blocked types are never allowed."
        }
      },
      "additionalProperties": false,
      "title": "SecurityConfig",
      "description": "Security settings for layer downloads"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Send anonymous CLI usage telemetry. Set to false to opt out. Default: true"
        }
      },
      "additionalProperties": false,
      "title": "TelemetryConfig",
      "description": "Telemetry preferences"
    },
    "anonymousId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Anonymous telemetry identifier. The CLI generates it once and keeps it across resets."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RegistryEntry": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "Simple registry URL"
        },
        {
          "$ref": "#/$defs/RegistryEntryObject"
        }
      ],
      "title": "RegistryEntry",
      "description": "Registry configuration - URL string or object with authentication"
    },
    "RegistryEntryObject": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Registry base URL"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTP headers for authentication (supports ${ENV_VAR} expansion)"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Query parameters to include in requests"
        },
        "cache": {
          "type": "object",
          "properties": {
            "ttl": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Cache TTL in seconds. 0 disables caching for this registry."
            }
          },
          "additionalProperties": false,
          "title": "RegistryCacheConfig",
          "description": "Per-registry cache settings"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "title": "RegistryEntryObject",
      "description": "Registry configuration with authentication options"
    },
    "GlobalDefaults": {
      "type": "object",
      "properties": {
        "output": {
          "default": "json",
          "description": "Default output format for artifacts: json, yaml, typed (json + .d.ts), or ts (TypeScript module)",
          "anyOf": [
            {
              "type": "string",
              "const": "json"
            },
            {
              "type": "string",
              "const": "yaml"
            },
            {
              "type": "string",
              "const": "typed"
            },
            {
              "type": "string",
              "const": "ts"
            }
          ],
          "title": "ArtifactOutputFormat"
        },
        "artifactsDir": {
          "default": "artifacts",
          "description": "Default directory for installed artifacts",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "title": "GlobalDefaults",
      "description": "Default settings for CLI operations"
    }
  }
}