{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.paradoc.dev/registry-item.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema URI for validation"
    },
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "const": "form"
        },
        {
          "type": "string",
          "const": "document"
        },
        {
          "type": "string",
          "const": "checklist"
        },
        {
          "type": "string",
          "const": "bundle"
        }
      ],
      "description": "Artifact kind"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-_]*$",
      "description": "Artifact name"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable title"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Artifact description"
    },
    "layers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "Layer key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/RegistryLayer"
      },
      "description": "Available layers"
    },
    "defaultLayer": {
      "type": "string",
      "description": "Default layer key"
    }
  },
  "required": [
    "kind",
    "name",
    "version"
  ],
  "additionalProperties": {},
  "title": "Paradoc Registry Item",
  "description": "Schema for registry item files (r/{name}.json)",
  "$defs": {
    "RegistryLayer": {
      "oneOf": [
        {
          "$ref": "#/$defs/RegistryInlineLayer"
        },
        {
          "$ref": "#/$defs/RegistryFileLayer"
        }
      ],
      "title": "RegistryLayer",
      "description": "Layer in a registry item - inline or file with URL",
      "allOf": [
        {
          "if": {
            "required": [
              "bindings"
            ]
          },
          "then": {
            "properties": {
              "mimeType": {
                "pattern": "^[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN]/[pP][dD][fF]$"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bindingsFrom"
            ]
          },
          "then": {
            "properties": {
              "mimeType": {
                "pattern": "^[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN]/[pP][dD][fF]$"
              }
            }
          }
        }
      ]
    },
    "RegistryInlineLayer": {
      "type": "object",
      "properties": {
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "MIME type of the layer content"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Human-readable title for this layer"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Description of what this layer represents"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 checksum for integrity verification"
        },
        "kind": {
          "type": "string",
          "const": "inline"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "description": "Layer content with interpolation placeholders (e.g., {{fields.fieldName}})"
        },
        "bindings": {
          "not": {}
        },
        "bindingsFrom": {
          "not": {}
        }
      },
      "required": [
        "mimeType",
        "kind",
        "text"
      ],
      "additionalProperties": false,
      "title": "RegistryInlineLayer",
      "description": "Inline layer with embedded content"
    },
    "RegistryFileLayer": {
      "type": "object",
      "properties": {
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "MIME type of the layer content"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Human-readable title for this layer"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Description of what this layer represents"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 checksum for integrity verification"
        },
        "kind": {
          "type": "string",
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Relative path for the layer file when installed"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to download the layer file from"
        },
        "font": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "Relative path for the font file when installed"
            },
            "checksum": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "SHA-256 checksum for integrity verification"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "description": "Font a PDF layer draws with, installed beside the layer file"
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "AcroForm field name in the PDF template, fully qualified (e.g., topmostSubform[0].Page1[0].f1_01[0])"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Paradoc path whose value fills the field (e.g., fields.name, parties.buyer.name)"
          },
          "description": "PDF layers only. Maps each AcroForm field name (key) to the Paradoc path (value) that fills it"
        },
        "bindingsFrom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "PDF layers only. Key of a sibling PDF layer whose bindings this layer reuses"
        }
      },
      "required": [
        "mimeType",
        "kind",
        "path",
        "url"
      ],
      "additionalProperties": false,
      "title": "RegistryFileLayer",
      "description": "File-backed layer with download URL"
    }
  }
}