{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.paradoc.dev/2026-08-06/fieldsetfield.json",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Display label for the field"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Description or help text for the field"
    },
    "required": {
      "$ref": "https://schema.paradoc.dev/2026-08-06.json/$defs/CondExpr"
    },
    "visible": {
      "$ref": "https://schema.paradoc.dev/2026-08-06.json/$defs/CondExpr"
    },
    "type": {
      "type": "string",
      "const": "fieldset"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z][a-zA-Z0-9_]*$",
        "description": "Nested field identifier (camelCase, starts with lowercase letter)"
      },
      "additionalProperties": {
        "$ref": "https://schema.paradoc.dev/2026-08-06.json/$defs/FormField"
      }
    }
  },
  "required": [
    "type",
    "fields"
  ],
  "additionalProperties": false,
  "title": "FieldsetField"
}