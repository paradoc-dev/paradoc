                "type": "number",
                "minimum": 1,
                "description": "Width of the field in points"
              },
              "height": {
                "type": "number",
                "minimum": 1,
                "description": "Height of the field in points"
              },
              "partyRole": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
