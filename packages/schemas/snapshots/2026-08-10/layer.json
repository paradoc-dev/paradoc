              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Human-readable label"
              },
              "placement": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "auto",
                    "description": "Marker-based: injected at render, located after conversion"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "1-based page number"
                      },
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "description": "X in points from the left page edge"
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Y in points from the top page edge"
                      },
                      "width": {
                        "type": "number",
                        "minimum": 1,
                        "description": "Width in points"
                      },
                      "height": {
                        "type": "number",
                        "minimum": 1,
                        "description": "Height in points"
                      }
                    },
                    "required": [
                      "page",
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "anchor": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500,
                            "description": "Literal document text to find; must be unique unless occurrence is set"
                          },
