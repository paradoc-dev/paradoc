                            "type": "number",
                            "description": "Horizontal offset in points from the left of the found text"
                          },
                          "offsetY": {
                            "type": "number",
                            "description": "Vertical offset in points from the top of the found text"
                          },
                          "occurrence": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "1-based match index in reading order when the text repeats"
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "width": {
                        "type": "number",
                        "minimum": 1,
                        "description": "Width in points"
                      },
                      "height": {
                        "type": "number",
                        "minimum": 1,
                        "description": "Height in points"
                      }
                    },
                    "required": [
                      "anchor",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "Placement: 'auto', absolute coordinates, or a text anchor"
              }
            },
            "required": [
              "party",
              "type",
              "placement"
            ],
            "additionalProperties": false
          },
          "description": "Unified signature slots keyed by slot id. Supersedes signatureBlocks/anchorBlocks"
        },
        "kind": {
          "type": "string",
          "const": "inline"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "description": "Layer content with interpolation placeholders (e.g., {{fieldName}})"
