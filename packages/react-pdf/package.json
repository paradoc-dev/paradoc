{
  "name": "@paradoc/react-pdf",
  "version": "0.5.0",
  "description": "PDF rendering and composition checks for @paradoc/react",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./chromium": { "types": "./dist/chromium.d.ts", "import": "./dist/chromium.js", "default": "./dist/chromium.js" },
    "./check": { "types": "./dist/check.d.ts", "import": "./dist/check.js", "default": "./dist/check.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/paradoc-dev/paradoc.git",
    "directory": "packages/react-pdf"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/noto-sans-arabic": "catalog:",
    "@fontsource-variable/source-serif-4": "catalog:",
    "@fontsource/noto-sans-symbols-2": "catalog:",
    "@paradoc/react": "workspace:^",
    "@takumi-rs/helpers": "catalog:",
    "takumi-pdf": "catalog:"
  },
  "peerDependencies": {
    "puppeteer": "catalog:",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "catalog:"
  },
  "peerDependenciesMeta": {
    "puppeteer": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@paradoc/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "puppeteer": "catalog:",
    "react": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
