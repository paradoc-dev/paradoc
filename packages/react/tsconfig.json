{
  "extends": "@paradoc/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "types",
    "vitest.config.ts",
    "vitest.parity.config.ts",
    "vitest.registry.config.ts"
  ],
  // The registry fixture is source for the scratch project the install suite
  // builds, not for this package: it imports `@/components/paradoc/*`, which
  // exists only where the CLI installs it.
  "exclude": ["node_modules", "dist", "tests/registry/fixtures"]
}
