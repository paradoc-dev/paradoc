{
  "extends": "@paradoc/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@paradoc/react": ["./src/index.ts"]
    }
  },
  "include": [
    "src",
    "tests",
    "types",
    "vitest.config.ts"
  ]
}
