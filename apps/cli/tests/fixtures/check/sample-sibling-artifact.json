{
  "$schema": "https://schema.paradoc.dev/schema.json",
  "kind": "form",
  "name": "check-cli-sample-sibling",
  "version": "1.0.0",
  "title": "Check CLI sample-sibling fixture",
  "fields": {
    "lineItems": {
      "type": "list",
      "label": "Line items",
      "required": true,
      "visible": true,
      "item": {
        "type": "fieldset",
        "label": "Line item",
        "fields": {
          "description": {
            "type": "text",
            "label": "Description",
            "required": true,
            "visible": true
          }
        }
      }
    }
  },
  "layers": {
    "composition": {
      "kind": "file",
      "mimeType": "text/tsx",
      "path": "sample-sibling-composition.tsx",
      "title": "Composition"
    }
  }
}
