#!/usr/bin/env bash
# Clean the playground directory, keeping only the paradoc and clean scripts

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

# Remove all files and directories except paradoc and clean scripts
find . -mindepth 1 -maxdepth 1 ! -name 'paradoc' ! -name 'clean' -exec rm -rf {} +

echo "✓ Playground cleaned (kept paradoc and clean scripts)"
